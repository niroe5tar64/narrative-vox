{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-vox/schemas/blueprint.schema.json",
  "title": "Project Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "project_intent",
    "theme_catalog",
    "episode_plan",
    "coverage_matrix",
    "continuity_plan",
    "quality_checks"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "title", "episode_count", "total_duration_min"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "episode_count": { "type": "integer", "minimum": 1 },
        "total_duration_min": { "type": "number", "minimum": 0 }
      }
    },
    "project_intent": { "type": "string", "minLength": 1 },
    "theme_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theme_id",
          "theme_title",
          "theme_summary",
          "prerequisite_theme_ids",
          "importance"
        ],
        "properties": {
          "theme_id": { "type": "string", "pattern": "^T[0-9]{2}$" },
          "theme_title": { "type": "string", "minLength": 1 },
          "theme_summary": { "type": "string", "minLength": 1 },
          "prerequisite_theme_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^T[0-9]{2}$" }
          },
          "importance": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          }
        }
      }
    },
    "episode_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_id",
          "title",
          "duration_min",
          "source_section_ids",
          "target_theme_ids"
        ],
        "properties": {
          "episode_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "duration_min": { "type": "number", "minimum": 0 },
          "themes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_section_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^SRC[0-9]{4}$" }
          },
          "target_theme_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^T[0-9]{2}$" }
          }
        }
      }
    },
    "coverage_matrix": { "type": "object" },
    "continuity_plan": { "type": "object" },
    "quality_checks": { "type": "object" }
  }
}
