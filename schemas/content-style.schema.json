{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-vox/schemas/content-style.schema.json",
  "title": "Content Style",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "style_id",
    "style_name",
    "description",
    "format",
    "pacing",
    "language",
    "segment_structure",
    "interaction",
    "content_treatment"
  ],
  "properties": {
    "style_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "style_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker_mode", "speaker_count", "speaker_roles"],
      "properties": {
        "speaker_mode": {
          "type": "string",
          "enum": ["monologue", "dialogue", "panel"]
        },
        "speaker_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "speaker_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "utterance_share"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["lead", "questioner", "commentator", "narrator"]
              },
              "utterance_share": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          }
        }
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_duration_minutes",
        "utterance_length",
        "section_transition_style",
        "pause_between_sections_ms",
        "reflection_pause_ms"
      ],
      "properties": {
        "target_duration_minutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "utterance_length": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_chars", "max_chars"],
          "properties": {
            "target_chars": { "type": "integer", "minimum": 1 },
            "max_chars": { "type": "integer", "minimum": 1 }
          }
        },
        "section_transition_style": {
          "type": "string",
          "enum": ["explicit_heading", "verbal_bridge", "natural_flow"]
        },
        "pause_between_sections_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "reflection_pause_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formality",
        "sentence_endings",
        "technical_term_treatment",
        "code_verbalization"
      ],
      "properties": {
        "formality": {
          "type": "string",
          "enum": ["formal", "polite", "casual"]
        },
        "sentence_endings": {
          "type": "string",
          "enum": ["declarative", "mixed", "conversational"]
        },
        "technical_term_treatment": {
          "type": "string",
          "enum": ["define_on_first_use", "assume_known", "explain_inline"]
        },
        "code_verbalization": {
          "type": "string",
          "enum": ["meaning_only", "structure_then_meaning", "skip"]
        }
      }
    },
    "segment_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat_content_ratio",
        "opening_style",
        "closing_style",
        "allow_tangent",
        "repetition_strategy"
      ],
      "properties": {
        "chat_content_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 0.5
        },
        "opening_style": {
          "type": "string",
          "enum": ["direct_topic", "hook_question", "casual_greeting", "recap_previous"]
        },
        "closing_style": {
          "type": "string",
          "enum": ["summary_points", "call_to_action", "preview_next", "open_question"]
        },
        "allow_tangent": {
          "type": "boolean"
        },
        "repetition_strategy": {
          "type": "string",
          "enum": ["no_repetition", "key_points_repeated", "section_summaries"]
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_frequency",
        "listener_address",
        "reaction_utterances"
      ],
      "properties": {
        "question_frequency": {
          "type": "string",
          "enum": ["none", "per_section", "frequent"]
        },
        "listener_address": {
          "type": "string",
          "enum": ["none", "occasional", "frequent"]
        },
        "reaction_utterances": {
          "type": "boolean"
        }
      }
    },
    "content_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analogy_usage",
        "example_density",
        "humor_level",
        "emphasis_technique"
      ],
      "properties": {
        "analogy_usage": {
          "type": "string",
          "enum": ["none", "one_per_episode", "per_concept"]
        },
        "example_density": {
          "type": "string",
          "enum": ["minimal", "moderate", "rich"]
        },
        "humor_level": {
          "type": "string",
          "enum": ["none", "light", "moderate"]
        },
        "emphasis_technique": {
          "type": "string",
          "enum": ["repetition", "contrast", "question_answer", "dramatic_pause"]
        }
      }
    }
  }
}
