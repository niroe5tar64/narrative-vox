{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-vox/schemas/project-config.schema.json",
  "title": "Project Config",
  "oneOf": [
    { "$ref": "#/$defs/techExplainerConfig" },
    { "$ref": "#/$defs/ossDiveConfig" }
  ],
  "$defs": {
    "techExplainerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GENRE_ID", "PROJECT_ID", "STYLE_ID", "CAST", "SOURCE_MARKDOWN_PATHS"],
      "properties": {
        "GENRE_ID": { "type": "string", "const": "tech-explainer" },
        "PROJECT_ID": { "type": "string", "minLength": 1 },
        "STYLE_ID": { "type": "string", "minLength": 1 },
        "PROJECT_TITLE": { "type": "string" },
        "AUDIENCE_BACKGROUND": { "type": "string" },
        "AUDIENCE_LEVEL": { "type": "string" },
        "AUDIENCE_INTEREST": { "type": "string" },
        "BASELINE_CONTEXT_OR_EMPTY": { "type": "string" },
        "EXISTING_AUDIO_SCRIPT_DIR_OR_EMPTY": { "type": "string" },
        "CAST": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "NOTES": { "type": "string" },
        "SOURCE_MARKDOWN_PATHS": { "type": "string", "minLength": 1 },
        "SOURCE_EXCLUDE_PATHS": {
          "type": "array",
          "items": { "type": "string" }
        },
        "SOURCE_LANGUAGE_HINT": {
          "type": "string",
          "enum": ["en", "ja", "mixed"]
        }
      }
    },
    "ossDiveConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GENRE_ID",
        "PROJECT_ID",
        "STYLE_ID",
        "CAST",
        "REPO_ROOT_PATH",
        "DEEP_DIVE_FOCUS"
      ],
      "properties": {
        "GENRE_ID": { "type": "string", "const": "oss-dive" },
        "PROJECT_ID": { "type": "string", "minLength": 1 },
        "STYLE_ID": { "type": "string", "minLength": 1 },
        "PROJECT_TITLE": { "type": "string" },
        "AUDIENCE_BACKGROUND": { "type": "string" },
        "AUDIENCE_LEVEL": { "type": "string" },
        "AUDIENCE_INTEREST": { "type": "string" },
        "BASELINE_CONTEXT_OR_EMPTY": { "type": "string" },
        "EXISTING_AUDIO_SCRIPT_DIR_OR_EMPTY": { "type": "string" },
        "CAST": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "NOTES": { "type": "string" },
        "REPO_ROOT_PATH": { "type": "string", "minLength": 1 },
        "DEEP_DIVE_FOCUS": { "type": "string", "minLength": 1 },
        "SOURCE_EXCLUDE_PATHS": {
          "type": "array",
          "items": { "type": "string" }
        },
        "SOURCE_LANGUAGE_HINT": {
          "type": "string",
          "enum": ["en", "ja", "mixed"]
        }
      }
    }
  }
}
