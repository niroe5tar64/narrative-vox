{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-vox/schemas/episode-pack.schema.json",
  "title": "Episode Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "learning_goal",
    "scope_guardrails",
    "comparison_mode",
    "target_theme_ids",
    "source_section_ids",
    "source_sections",
    "narrative_outline",
    "facts",
    "technical_terms",
    "continuity_hooks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "episode_title",
        "genre_id",
        "generated_at",
        "source_blueprint_path",
        "source_index_path"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "episode_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
        "episode_title": { "type": "string", "minLength": 1 },
        "genre_id": {
          "type": "string",
          "enum": ["tech-explainer", "oss-dive"]
        },
        "generated_at": { "type": "string" },
        "source_blueprint_path": { "type": "string", "minLength": 1 },
        "source_index_path": { "type": "string", "minLength": 1 }
      }
    },
    "learning_goal": { "type": "string", "minLength": 1 },
    "scope_guardrails": {
      "type": "array",
      "items": { "type": "string" }
    },
    "comparison_mode": {
      "type": "string",
      "enum": ["with_baseline", "standalone"]
    },
    "target_theme_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_section_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SRC[0-9]{4}$" }
    },
    "source_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "display_title", "token_estimate", "body"],
        "properties": {
          "section_id": { "type": "string", "pattern": "^SRC[0-9]{4}$" },
          "display_title": { "type": "string" },
          "token_estimate": { "type": "integer", "minimum": 0 },
          "body": { "type": "string" }
        }
      }
    },
    "narrative_outline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outline_id", "title", "goal", "required_fact_ids"],
        "properties": {
          "outline_id": { "type": "string", "pattern": "^S[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "required_fact_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^F[0-9]{3}$" }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "kind",
          "statement",
          "source_section_ids",
          "target_theme_ids",
          "depends_on",
          "importance"
        ],
        "properties": {
          "fact_id": { "type": "string", "pattern": "^F[0-9]{3}$" },
          "kind": {
            "type": "string",
            "enum": [
              "theme_intro",
              "definition",
              "mechanism",
              "comparison",
              "example",
              "tradeoff",
              "constraint",
              "takeaway"
            ]
          },
          "statement": { "type": "string", "minLength": 1 },
          "source_section_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^SRC[0-9]{4}$" }
          },
          "target_theme_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^F[0-9]{3}$" }
          },
          "importance": {
            "type": "string",
            "enum": ["must", "should"]
          }
        }
      }
    },
    "technical_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "source_section_ids", "priority"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "source_section_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^SRC[0-9]{4}$" }
          },
          "priority": {
            "type": "string",
            "enum": ["high", "normal"]
          }
        }
      }
    },
    "continuity_hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listener_state_additions",
        "open_loops_opened",
        "open_loops_resolved",
        "next_episode_handoff"
      ],
      "properties": {
        "listener_state_additions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "open_loops_opened": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["loop_id", "label"],
            "properties": {
              "loop_id": { "type": "string", "pattern": "^L[0-9]{3}$" },
              "label": { "type": "string", "minLength": 1 },
              "target_episode_id": {
                "type": "string",
                "pattern": "^E[0-9]{2}$"
              }
            }
          }
        },
        "open_loops_resolved": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next_episode_handoff": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
