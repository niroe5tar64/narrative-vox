{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-vox/schemas/series-context.schema.json",
  "title": "Series Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "completed_episode_ids",
    "covered_theme_ids",
    "covered_source_section_ids",
    "introduced_technical_terms",
    "listener_state",
    "open_loops",
    "resolved_loop_ids",
    "latest_episode"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "run_id",
        "through_episode_id",
        "generated_at",
        "source_episode_pack_path",
        "source_script_path"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "through_episode_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
        "generated_at": { "type": "string" },
        "source_episode_pack_path": { "type": "string", "minLength": 1 },
        "source_script_path": { "type": "string", "minLength": 1 },
        "previous_series_context_path": { "type": "string", "minLength": 1 }
      }
    },
    "completed_episode_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^E[0-9]{2}$" }
    },
    "covered_theme_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "covered_source_section_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SRC[0-9]{4}$" }
    },
    "introduced_technical_terms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "listener_state": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_loops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["loop_id", "label", "opened_in_episode_id"],
        "properties": {
          "loop_id": { "type": "string", "pattern": "^L[0-9]{3}$" },
          "label": { "type": "string", "minLength": 1 },
          "opened_in_episode_id": {
            "type": "string",
            "pattern": "^E[0-9]{2}$"
          },
          "target_episode_id": {
            "type": "string",
            "pattern": "^E[0-9]{2}$"
          }
        }
      }
    },
    "resolved_loop_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "latest_episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "episode_title",
        "handoff_to_next_episode",
        "section_count",
        "utterance_count",
        "speaker_turns"
      ],
      "properties": {
        "episode_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
        "episode_title": { "type": "string", "minLength": 1 },
        "handoff_to_next_episode": {
          "type": "array",
          "items": { "type": "string" }
        },
        "section_count": { "type": "integer", "minimum": 0 },
        "utterance_count": { "type": "integer", "minimum": 0 },
        "speaker_turns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker_key", "utterance_count"],
            "properties": {
              "speaker_key": { "type": "string", "minLength": 1 },
              "utterance_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
