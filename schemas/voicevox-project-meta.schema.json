{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VOICEVOX Project Meta",
  "type": "object",
  "required": ["generated_at", "adjustments"],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "adjustments": {
      "type": "object",
      "properties": {
        "speed_preset": {
          "type": "string",
          "minLength": 1
        },
        "emotion": {
          "type": "string",
          "minLength": 1
        },
        "intonation_scale_delta": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
