{
  "version": 1,
  "text_normalization": {
    "enabled": true,
    "rules": [
      {
        "id": "url",
        "pattern": "https?://[\\w./?#&=%~:@!$'()*+,;\\-]+",
        "replacement": "ユーアールエル",
        "enabled": true,
        "description": "URLを読み替え"
      },
      {
        "id": "inline_code_strip",
        "pattern": "`([^`]+)`",
        "replacement": "$1",
        "enabled": true,
        "description": "バッククォートを除去してコード内容を残す"
      },
      {
        "id": "number_ms",
        "pattern": "(\\d+)ms",
        "replacement": "$1ミリ秒",
        "enabled": true,
        "description": "ms単位を日本語に"
      },
      {
        "id": "number_px",
        "pattern": "(\\d+)px",
        "replacement": "$1ピクセル",
        "enabled": true,
        "description": "px単位を日本語に"
      },
      {
        "id": "number_kb",
        "pattern": "(\\d+)KB",
        "replacement": "$1キロバイト",
        "enabled": true,
        "description": "KB単位を日本語に"
      },
      {
        "id": "number_mb",
        "pattern": "(\\d+)MB",
        "replacement": "$1メガバイト",
        "enabled": true,
        "description": "MB単位を日本語に"
      },
      {
        "id": "number_gb",
        "pattern": "(\\d+)GB",
        "replacement": "$1ギガバイト",
        "enabled": true,
        "description": "GB単位を日本語に"
      },
      {
        "id": "number_hz",
        "pattern": "(\\d+(?:\\.\\d+)?)Hz",
        "replacement": "$1ヘルツ",
        "enabled": true,
        "description": "Hz単位を日本語に"
      },
      {
        "id": "number_khz",
        "pattern": "(\\d+(?:\\.\\d+)?)kHz",
        "replacement": "$1キロヘルツ",
        "enabled": true,
        "description": "kHz単位を日本語に"
      },
      {
        "id": "number_fps",
        "pattern": "(\\d+)fps",
        "replacement": "$1エフピーエス",
        "enabled": true,
        "description": "fps単位を日本語に"
      },
      {
        "id": "arrow_right",
        "pattern": "→",
        "replacement": "から",
        "enabled": true,
        "description": "右矢印を読み替え"
      },
      {
        "id": "strip_brackets_code",
        "pattern": "【[^】]*】",
        "replacement": "",
        "enabled": false,
        "description": "【】囲みを除去（必要時に有効化）"
      }
    ]
  },
  "dict_patch": {
    "enabled": true,
    "force_readings": [
      {
        "surface": "API",
        "reading": "エーピーアイ",
        "priority": "HIGH",
        "note": "force_patch"
      },
      {
        "surface": "CLI",
        "reading": "シーエルアイ",
        "priority": "HIGH",
        "note": "force_patch"
      }
    ],
    "suppress_surfaces": []
  }
}
