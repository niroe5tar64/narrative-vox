{
  "name": "narrative-vox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "server": "bun apps/api/src/index.ts",
    "server:dev": "bun --watch apps/api/src/index.ts",
    "web:dev": "cd apps/web && bun run dev",
    "dev": "bun run server:dev",
    "gen-blueprint": "bun apps/cli/src/main.ts gen-blueprint",
    "gen-material": "bun apps/cli/src/main.ts gen-material",
    "gen-script": "bun apps/cli/src/main.ts gen-script",
    "gen-digest": "bun apps/cli/src/main.ts gen-digest",
    "prepare-run": "bun apps/cli/src/main.ts prepare-run",
    "check-run": "bun apps/cli/src/main.ts check-run",
    "build-text": "bun apps/cli/src/main.ts build-text",
    "build-project": "bun apps/cli/src/main.ts build-project",
    "build-audio": "bun apps/cli/src/main.ts build-audio",
    "build-all": "bun apps/cli/src/main.ts build-all",
    "voicevox:up": "bash tools/scripts/voicevox-up.sh",
    "voicevox:down": "bash tools/scripts/voicevox-down.sh",
    "voicevox:check": "bash tools/scripts/voicevox-check.sh",
    "voicevox:dict-sync": "bun apps/cli/src/main.ts dict-sync",
    "format": "biome format",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "check": "bun run lint && bun run typecheck",
    "validate": "bun run format --write && bun run lint:fix && bun run typecheck",
    "lint:layers": "bun run scripts/check-layer-deps.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:web": "cd apps/web && bunx tsc -b"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "hono": "^4.12.0",
    "kuromoji": "^0.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^25.2.3",
    "@biomejs/biome": "^2.4.4",
    "typescript": "^5.9.3"
  }
}
