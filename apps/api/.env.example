# API サーバーのポート番号（デフォルト: 3000）
PORT=3000

# API サーバーのバインドアドレス（デフォルト: 0.0.0.0）
HOST=0.0.0.0

# CORS で許可するオリジン。設定しない場合は同一オリジン制約（ブラウザデフォルト）。
# 開発時は Vite の開発サーバーURLを指定する（例: http://localhost:5173）。
# ALLOWED_ORIGIN=http://localhost:5173

# セーフパス検証の起点となるリポジトリルート絶対パス。
# 設定しない場合はサーバー起動時の process.cwd() を使用する。
# REPO_ROOT=/path/to/narrative-vox
