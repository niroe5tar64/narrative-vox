# dependencies
node_modules/

# OS/editor
.DS_Store
.vscode/

# local temp workspace
.tmp/
tmp/

# logs / caches
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
coverage/
.nyc_output/
.cache/
.eslintcache

# env / secrets
.env
.env.*
!.env.example

# keep only documentation files under data/
data/**
!data/**/
!data/**/README.md

# optional local output buckets
outputs/
artifacts/

# generated audio assets (copyright / size risk)
*.wav
*.mp3
*.m4a
*.flac
*.ogg

# Claude Code
.claude/settings.local.json

# local config variants (secrets / machine-specific)
configs/**/*.local.json
configs/**/*.local.yaml
configs/**/*.local.yml
configs/**/*.secrets.*
configs/voice/voicevox/synthesis-defaults.json
!configs/**/*.example.json

# project/content specific configs (keep local by default)
configs/pipeline/projects/*.json
configs/content/novels/*.json
!configs/pipeline/projects/*.example.json
!configs/content/novels/*.example.json
